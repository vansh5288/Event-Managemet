# Blockchain Deployment Environment Variables
# Copy this file to .env and fill in your values

# Private key of the deployer wallet (WITHOUT 0x prefix for Hardhat accounts, WITH 0x for most others)
PRIVATE_KEY=

# Alchemy API key for testnet deployment
ALCHEMY_API_KEY=

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# Contract address after deployment (update server/.env with this)
CONTRACT_ADDRESS=

# Ethereum RPC URL (local Hardhat node or remote)
ETHEREUM_RPC_URL=http://127.0.0.1:8545

# Network to deploy to: localhost, sepolia, mumbai, amoy
NETWORK=localhost


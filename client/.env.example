# ─────────────────────────────────────────────────────────────
# EventHub Client — Environment Configuration
# Copy to `.env` and fill in your own values.
# The app builds & runs with these unset (graceful fallbacks).
# Vite exposes only VITE_* variables to the browser.
# ─────────────────────────────────────────────────────────────

# API base URL (leave empty to use same-origin / Vite proxy)
VITE_API_BASE_URL=

# Stripe publishable key (for Checkout page)
VITE_STRIPE_PUBLISHABLE_KEY=

# Razorpay key ID (for Checkout page)
VITE_RAZORPAY_KEY_ID=

# OAuth client IDs (for Google / GitHub login buttons)
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# Google OAuth redirect URI (must match server callback)
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/login
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/login

# Firebase push notifications (optional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


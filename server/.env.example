# ─────────────────────────────────────────────────────────────
# EventHub Server — Environment Configuration
# Copy to `.env` and fill in your own values.
# The app builds & runs with these unset (graceful fallbacks).
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/event-management

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# App URL (used in emails & OAuth redirects)
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# CORS — comma separated list
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EventHub <noreply@eventhub.app>

# Firebase (service account JSON string or path)
FIREBASE_SERVICE_ACCOUNT=

# SMS (Twilio architecture — optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AI
GOOGLE_AI_API_KEY=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Blockchain
ETHEREUM_RPC_URL=http://localhost:8545
CONTRACT_ADDRESS=
PRIVATE_KEY=

